{
  "env": {
    "VLLM_BASE_URL": {
      "description": "vLLM API base url",
      "required": true
    },
    "VLLM_API_KEY": {
      "description": "vLLM API key",
      "required": true
    },
    "VLLM_MODEL_NAME": {
      "description": "Model being served by vLLM",
      "required": true
    },
    "SERPER_API_TOKEN": {
      "description": "Serper.dev API key for web search",
      "required": true,
      "link": "https://serper.dev"
    },
    "HF_TOKEN": {
      "description": "Hugging Face token (for gated models)",
      "required": false,
      "link": "https://huggingface.co/settings/tokens"
    }
  }
}
